# Copy to .env (or export these) before `npm start`.

# Lets Claude pick genres, suggest titles and speak as the librarian.
# Without it the library still works, using simple offline helpers.
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# LIBRARY_DB=./data/library.db
# LIBRARY_MODEL=claude-opus-5-5
# LIBRARY_EFFORT=low
# LIBRARY_AI=off            # force the offline helpers even when a key is set
# REPORT_THRESHOLD=3        # reports from different readers before a book is taken off the shelf
# TRUST_PROXY=1             # set when running behind a reverse proxy, so rate limits see real IPs
